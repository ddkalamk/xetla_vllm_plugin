/*******************************************************************************
 * int2 weight-only quantized GEMM with fp16 activations and per-K-group fp16
 * scales (no scale_A, no zero-points). Mirrors the kernel exercised by
 *   xetla/int2_fp16_upcvt_dpas_fast_test.
 *
 *   C[m,n] = sum_k  A[m,k] * (codeval(B[k,n]) * ScaleB[k/gs, n])
 *
 *   A      : fp16, row-major, [M, K]
 *   B      : int2x16, K-packed, [K/16, N] (uint32_t per 16 K-rows of one N col)
 *   ScaleB : fp16, row-major, [K/gs, N]      (gs = 128, fixed at compile time)
 *   C      : fp16, row-major, [M, N]
 *
 * int2 codes use {0, 1, 3} only:  0 -> 0, 1 -> +1, 3 -> -1  (code 2 forbidden).
 *******************************************************************************/

#include <c10/xpu/XPUStream.h>
#include <map>
#include <sycl/sycl.hpp>
#include <torch/extension.h>
#include <tuple>
#include <utility>

#include "timing_utils.h"
#include "xetla.hpp"

using namespace gpu::xetla;
using namespace sycl;

namespace {

// Fixed K-group for the fp16-scales upcvt kernel (matches the xetla test).
static constexpr int kScaleGS = 128;

// Unique kernel-name tag to avoid mangled-name collisions between
// (XT, WGM, WGN, SGM, SGN, SGK, KS, LS, kUnaligned) instantiations.
template <
    typename XT, int WGM, int WGN, int SGM, int SGN, int SGK, int KS, int LS,
    bool kUnaligned>
class int2_upcvt_kernel_tag;

// XT is the activation / scale / output element type: gpu::xetla::fp16 or
// gpu::xetla::bf16. The dequant is bit work on 16-bit lanes, so both work.
template <
    typename XT, int WGM, int WGN, int SGM, int SGN, int SGK, int KS, int LS,
    bool kUnaligned>
sycl::event int2_upcvt_gemm_impl(
    sycl::queue& queue, const size_t M, const size_t N, const size_t K,
    XT* A_d, int32_t* B_d, XT* C_d, XT* ScaleB_d,
    float* Acc_d, uint32_t* Cnt_d) {
  using data_type_a = XT;
  using data_type_b = int2x16;
  using data_type_c = XT;
  using data_type_acc = float;
  using data_type_scale = XT;

  constexpr int wg_tile_m = WGM;
  constexpr int wg_tile_n = WGN;
  constexpr int sg_tile_m = SGM;
  constexpr int sg_tile_n = SGN;
  constexpr int sg_tile_k = SGK;
  constexpr uint32_t prefetch_distance = 0;
  constexpr uint32_t periodic_sync_interval = 0;
  constexpr uint32_t global_kslicing = KS;
  constexpr uint32_t local_kslicing = LS;

  static constexpr gpu_arch arch_tag = gpu_arch::Xe;

  using tile_shape = gpu::xetla::group::tile_shape_t<
      wg_tile_n, wg_tile_m, sg_tile_n, sg_tile_m>;
  using mem_desc_a_t = gpu::xetla::mem_desc_t<
      data_type_a, mem_layout::row_major, mem_space::global>;
  using mem_desc_b_t = gpu::xetla::mem_desc_t<
      data_type_b, mem_layout::row_major, mem_space::global>;
  using mem_desc_c_t = gpu::xetla::mem_desc_t<
      data_type_c, mem_layout::row_major, mem_space::global>;

  using compute_attr = gpu::xetla::group::compute_attr_t<
      data_type_a, data_type_a, data_type_acc>;
  using perf_tuning_knob = gpu::xetla::group::perf_tuning_knob_t<
      sg_tile_k, prefetch_distance, periodic_sync_interval>;
  using compute_policy = gpu::xetla::group::compute_policy_int2_fp16_upcvt_xmx<
      compute_attr, perf_tuning_knob, data_type_scale, kScaleGS,
      /*mma_xmx_m=*/SGM, arch_tag, /*use_unaligned_n=*/kUnaligned>;
  using gemm_t = gpu::xetla::group::gemm_t<
      compute_policy, tile_shape, mem_desc_a_t, mem_desc_b_t>;

  using epilogue_policy_t = std::conditional_t<
      kUnaligned, gpu::xetla::group::epilogue_policy_unaligned<arch_tag>,
      gpu::xetla::group::epilogue_policy_default<arch_tag>>;
  using mem_desc_c_epilogue_t = std::conditional_t<
      kUnaligned,
      gpu::xetla::mem_desc_t<
          data_type_c, mem_layout::row_major, mem_space::global,
          /*alignment=*/1>,
      mem_desc_c_t>;
  using epilogue_t = gpu::xetla::group::epilogue_t<
      epilogue_policy_t, tile_shape, mem_desc_c_epilogue_t>;

  using group_swizzle = gpu::xetla::kernel::group_swizzle_default<arch_tag>;
  using gemm_op_t = gpu::xetla::kernel::gemm_universal_t<
      gpu::xetla::kernel::dispatch_policy_int2_fp16_upcvt_kslicing<
          group_swizzle, global_kslicing, local_kslicing>,
      gemm_t, epilogue_t>;

  uint32_t lda = static_cast<uint32_t>(K);
  uint32_t ldb = static_cast<uint32_t>(N);
  uint32_t ldc = static_cast<uint32_t>(N);
  uint32_t lds = static_cast<uint32_t>(N);

  typename gemm_op_t::arguments_t gemm_arg(
      static_cast<uint32_t>(M), static_cast<uint32_t>(K),
      static_cast<uint32_t>(N), A_d, lda, reinterpret_cast<int2x16*>(B_d), ldb,
      C_d, ldc, ScaleB_d, lds, Acc_d, Cnt_d);

  if (!gemm_op_t::can_implement(gemm_arg)) {
    std::cout << "int2_fp16_upcvt: arguments not supported (M=" << M
              << " N=" << N << " K=" << K << ")\n";
    exit(1);
  }
  sycl::nd_range<3> nd_range = gemm_op_t::get_nd_range(gemm_arg);

  using kernel_name_t =
      int2_upcvt_kernel_tag<XT, WGM, WGN, SGM, SGN, SGK, KS, LS, kUnaligned>;

  Timer t("int2_fp16_upcvt_submit");
  return queue.submit([&](handler& cgh) {
    cgh.parallel_for<kernel_name_t>(
        nd_range, [=](nd_item<3> item) KERNEL_MAIN {
          slm_barrier_init<gemm_op_t>();
          gemm_op_t gemm_op;
          gemm_op(item, gemm_arg);
        });
  });
}

// Get a scratch (Acc, Cnt) buffer pair sized for the worst case across the
// instantiations we precompile (KS, LS up to 4). The kslicing kernel writes
// per-WG accumulators into Acc and uses Cnt as a barrier counter, so we
// allocate once per device and reuse across calls. Sizes returned by
// `gemm_op_t::get_acc_buf_size(M, N)` are the same across our (KS, LS)
// pairs in elements (but we conservatively over-allocate).
struct UpcvtScratch {
  float* acc = nullptr;
  uint32_t* cnt = nullptr;
  size_t acc_bytes = 0;
  size_t cnt_bytes = 0;
};

UpcvtScratch& get_scratch(sycl::queue& q, size_t need_acc_bytes, size_t need_cnt_bytes) {
  // One scratch buffer per process. vLLM XPU uses a single device per worker,
  // so a singleton is sufficient and avoids the sycl::device ordering issue
  // that would prevent using std::map.
  static UpcvtScratch s;
  if (s.acc_bytes < need_acc_bytes) {
    if (s.acc)
      sycl::free(s.acc, q.get_context());
    s.acc = static_cast<float*>(sycl::aligned_alloc_device(
        256, need_acc_bytes, q.get_device(), q.get_context()));
    s.acc_bytes = need_acc_bytes;
    q.memset(s.acc, 0, need_acc_bytes).wait();
  }
  if (s.cnt_bytes < need_cnt_bytes) {
    if (s.cnt)
      sycl::free(s.cnt, q.get_context());
    s.cnt = static_cast<uint32_t*>(sycl::aligned_alloc_device(
        256, need_cnt_bytes, q.get_device(), q.get_context()));
    s.cnt_bytes = need_cnt_bytes;
    q.memset(s.cnt, 0, need_cnt_bytes).wait();
  }
  return s;
}

// Function-pointer type for one compiled tile/kslicing variant.
template <typename XT>
using upcvt_fn_t = sycl::event (*)(
    sycl::queue&, size_t, size_t, size_t, XT*, int32_t*, XT*,
    XT*, float*, uint32_t*);

// Adapter that also computes the scratch sizes (which depend on the same
// compile-time params via gemm_op_t::get_acc_buf_size / get_cnt_buf_size).
template <
    typename XT, int WGM, int WGN, int SGM, int SGN, int SGK, int KS, int LS,
    bool kUnaligned>
sycl::event upcvt_dispatch(
    sycl::queue& q, size_t M, size_t N, size_t K, XT* A, int32_t* B,
    XT* C, XT* SB, float* acc, uint32_t* cnt) {
  return int2_upcvt_gemm_impl<XT, WGM, WGN, SGM, SGN, SGK, KS, LS, kUnaligned>(
      q, M, N, K, A, B, C, SB, acc, cnt);
}

// Compute scratch byte requirements for a given (M, N, KS, LS) by
// instantiating a throw-away gemm_op_t to call its static helpers.
template <
    typename XT, int WGM, int WGN, int SGM, int SGN, int SGK, int KS, int LS,
    bool kUnaligned>
std::pair<size_t, size_t> upcvt_scratch_bytes(size_t M, size_t N) {
  using data_type_a = XT;
  using data_type_b = int2x16;
  using data_type_c = XT;
  using data_type_acc = float;
  using data_type_scale = XT;
  static constexpr gpu_arch arch_tag = gpu_arch::Xe;
  using tile_shape =
      gpu::xetla::group::tile_shape_t<WGN, WGM, SGN, SGM>;
  using mem_desc_a_t = gpu::xetla::mem_desc_t<
      data_type_a, mem_layout::row_major, mem_space::global>;
  using mem_desc_b_t = gpu::xetla::mem_desc_t<
      data_type_b, mem_layout::row_major, mem_space::global>;
  using mem_desc_c_t = gpu::xetla::mem_desc_t<
      data_type_c, mem_layout::row_major, mem_space::global>;
  using compute_attr = gpu::xetla::group::compute_attr_t<
      data_type_a, data_type_a, data_type_acc>;
  using perf_tuning_knob =
      gpu::xetla::group::perf_tuning_knob_t<SGK, 0, 0>;
  using compute_policy = gpu::xetla::group::compute_policy_int2_fp16_upcvt_xmx<
      compute_attr, perf_tuning_knob, data_type_scale, kScaleGS, SGM, arch_tag,
      kUnaligned>;
  using gemm_t = gpu::xetla::group::gemm_t<
      compute_policy, tile_shape, mem_desc_a_t, mem_desc_b_t>;
  using epilogue_policy_t = std::conditional_t<
      kUnaligned, gpu::xetla::group::epilogue_policy_unaligned<arch_tag>,
      gpu::xetla::group::epilogue_policy_default<arch_tag>>;
  using mem_desc_c_epilogue_t = std::conditional_t<
      kUnaligned,
      gpu::xetla::mem_desc_t<
          data_type_c, mem_layout::row_major, mem_space::global, 1>,
      mem_desc_c_t>;
  using epilogue_t = gpu::xetla::group::epilogue_t<
      epilogue_policy_t, tile_shape, mem_desc_c_epilogue_t>;
  using group_swizzle = gpu::xetla::kernel::group_swizzle_default<arch_tag>;
  using gemm_op_t = gpu::xetla::kernel::gemm_universal_t<
      gpu::xetla::kernel::dispatch_policy_int2_fp16_upcvt_kslicing<
          group_swizzle, KS, LS>,
      gemm_t, epilogue_t>;
  size_t acc_elems = gemm_op_t::get_acc_buf_size(M, N);
  size_t cnt_elems = gemm_op_t::get_cnt_buf_size(M, N);
  return {acc_elems * sizeof(data_type_acc), cnt_elems * sizeof(uint32_t)};
}

} // namespace

// -- Public entry point: pick a precompiled variant based on (M, N) ----------
//
// We precompile a small set of useful variants (matching the M=1 GEMV-tuned
// tiers from the upcvt test driver). For M>1 we currently use a single GEMV
// fallback (KS=1, LS=1, WGN=128); this is suboptimal for prefill but works
// correctly for any (M, K, N) with K divisible by 128 and 16.
template <typename XT>
sycl::event int2_upcvt_gemm_run(
    sycl::queue& q, const size_t M, const size_t N, const size_t K,
    XT* A, int32_t* B, XT* C, XT* ScaleB) {
  const bool aligned_n = (N % 4 == 0);

  // Compute worst-case scratch bytes across the variants we may dispatch
  // to (KS up to 4, LS up to 8 dominates) and ensure the cached scratch
  // covers it.
  auto bytes_aligned = upcvt_scratch_bytes<
      XT, /*WGM*/ 1, /*WGN*/ 128, /*SGM*/ 1, /*SGN*/ 16, /*SGK*/ 128, /*KS*/ 4,
      /*LS*/ 8, /*kUnaligned*/ false>(M, N);
  auto bytes_unaligned = upcvt_scratch_bytes<
      XT, /*WGM*/ 1, /*WGN*/ 128, /*SGM*/ 1, /*SGN*/ 16, /*SGK*/ 128, /*KS*/ 4,
      /*LS*/ 8, /*kUnaligned*/ true>(M, N);
  size_t need_acc =
      std::max(bytes_aligned.first, bytes_unaligned.first);
  size_t need_cnt =
      std::max(bytes_aligned.second, bytes_unaligned.second);
  auto& sc = get_scratch(q, need_acc, need_cnt);

  // Dispatch table. We instantiate one compiled kernel per (KS, LS, kUnaligned)
  // triple that we want to use; tile shape is fixed at WGM=1/SGM=1/SGN=16/SGK=128
  // and WGN tracked separately.
#define DISPATCH_RAW(WGN_, KS_, LS_)                                          \
  do {                                                                        \
    if (aligned_n)                                                            \
      return upcvt_dispatch<                                                  \
          XT, /*WGM*/ 1, WGN_, /*SGM*/ 1, /*SGN*/ 16, /*SGK*/ 128, KS_, LS_,  \
          /*kUnaligned*/ false>(q, M, N, K, A, B, C, ScaleB, sc.acc, sc.cnt); \
    else                                                                      \
      return upcvt_dispatch<                                                  \
          XT, /*WGM*/ 1, WGN_, /*SGM*/ 1, /*SGN*/ 16, /*SGK*/ 128, KS_, LS_,  \
          /*kUnaligned*/ true>(q, M, N, K, A, B, C, ScaleB, sc.acc, sc.cnt);  \
  } while (0)

// K is split KS ways globally and LS ways locally, each slice consuming whole
// SGK=128 chunks, so K must divide evenly by KS*LS*128. It silently produced
// NaNs otherwise (e.g. MoE down_proj with K=768 under the KS=2,LS=4 tier), so
// step down to a slicing that divides before falling back to no slicing.
#define K_DIVIDES(KS_, LS_) ((K % ((KS_) * (LS_) * 128)) == 0)
#define DISPATCH(WGN_, KS_, LS_)                                              \
  do {                                                                        \
    if (K_DIVIDES(KS_, LS_))     { DISPATCH_RAW(WGN_, KS_, LS_); }            \
    else if (K_DIVIDES(1, 2))    { DISPATCH_RAW(WGN_, 1, 2); }                \
    else                         { DISPATCH_RAW(WGN_, 1, 1); }                \
  } while (0)

  if (M == 1) {
    // ----- Bonsai-8B GEMV shapes: tuned configs from
    // xetla/int2_fp16_upcvt_dpas_fast_test/results/bonsai_8B_run1/best.csv
    // Format: (K, N) -> (WGN, KS, LS), measured GiB/s on Xe2.
    //   (4096,   6144)  -> (32, 1, 4)   381.96 GiB/s   (qkv_proj 1k-head)
    //   (4096,  12288)  -> (32, 1, 2)   412.00 GiB/s   (gate/up_proj fused?)
    //   (4096,  24576)  -> (32, 1, 4)   430.57 GiB/s   (gate_up_proj fused)
    //   (4096, 151680)  -> (32, 1, 4)   434.78 GiB/s   (lm_head)
    //   (12288,  4096)  -> (32, 1, 8)   418.83 GiB/s   (down_proj)
    if (K == 4096 && N == 6144)        { DISPATCH(32, 1, 4); }
    else if (K == 4096 && N == 12288)  { DISPATCH(32, 1, 2); }
    else if (K == 4096 && N == 24576)  { DISPATCH(32, 1, 4); }
    else if (K == 4096 && N == 151680) { DISPATCH(32, 1, 4); }
    else if (K == 12288 && N == 4096)  { DISPATCH(32, 1, 8); }
    // ----- Bonsai-27B (Qwen3.5) GEMV shapes. The generic tiers below put
    // these on wg_n=64/128; moving them all to the (32, 1, 4) tier that wins
    // for the 8B was worth +10.6% end-to-end decode on a B70
    // (42.9 -> 47.4 tok/s), with identical accuracy (mean_rel 1.77e-4).
    //
    // The local-kslicing factor was then refined per shape with the standalone
    // driver (xetla/int2_fp16_upcvt_dpas_fast_test, --wgn/--ks/--ls), which
    // rotates over enough distinct buffer sets (>=4 GB footprint) to defeat
    // the caches and report honest DRAM bandwidth. 200 iters x 3 repeats,
    // spread across repeats < 1%. Effective GiB/s at wg_n=32, KS=1:
    //                                        LS=2     LS=4     LS=8
    //   (5120,  34816)  mlp.gate_up_proj     373.1    390.8   *400.2
    //   (17408,  5120)  mlp.down_proj        258.5   *406.1    324.5
    //   (5120,  16384)  in_proj_qkvz        *434.7    427.4    409.6
    //   (6144,   5120)  out_proj / o_proj    239.4   *361.5    292.1
    //   (5120,  14336)  self_attn.qkv_proj  *429.7    373.4    367.7
    //   (5120, 248320)  lm_head              432.2   *436.0    429.0
    // 64 decoder layers: 48 GDN (linear_attn) + 16 full attention.
    else if (K == 5120 && N == 34816)   { DISPATCH(32, 1, 8); }
    else if (K == 17408 && N == 5120)   { DISPATCH(32, 1, 4); }
    else if (K == 5120 && N == 16384)   { DISPATCH(32, 1, 2); }
    else if (K == 6144 && N == 5120)    { DISPATCH(32, 1, 4); }
    else if (K == 5120 && N == 14336)   { DISPATCH(32, 1, 2); }
    else if (K == 5120 && N == 248320)  { DISPATCH(32, 1, 4); }
    // Generic GEMV fallback tiers (kept from upcvt test driver).
    else if (N <= 4096) {
      DISPATCH(32, 2, 4);
    } else if (N <= 8192) {
      DISPATCH(64, 1, 4);
    } else if (N <= 16384) {
      DISPATCH(64, 1, 2);
    } else {
      DISPATCH(128, 1, 1);
    }
  }
  // M>1 fallback (works correctly; not perf-tuned for prefill).
  DISPATCH(128, 1, 1);
#undef DISPATCH
#undef DISPATCH_RAW
#undef K_DIVIDES
}

// Concrete entry points. fp16 is what Bonsai and the existing sidecars use;
// bf16 is for checkpoints that are natively bf16 (CAT-Q exports with
// use_bfloat16: true), where converting to fp16 would be an extra round trip.
sycl::event int2_fp16_upcvt_gemm_run(
    sycl::queue& q, const size_t M, const size_t N, const size_t K,
    gpu::xetla::fp16* A, int32_t* B, gpu::xetla::fp16* C,
    gpu::xetla::fp16* ScaleB) {
  return int2_upcvt_gemm_run<gpu::xetla::fp16>(q, M, N, K, A, B, C, ScaleB);
}

sycl::event int2_bf16_upcvt_gemm_run(
    sycl::queue& q, const size_t M, const size_t N, const size_t K,
    gpu::xetla::bf16* A, int32_t* B, gpu::xetla::bf16* C,
    gpu::xetla::bf16* ScaleB) {
  return int2_upcvt_gemm_run<gpu::xetla::bf16>(q, M, N, K, A, B, C, ScaleB);
}

// ---------------------------------------------------------------------------
// Torch op binding.

torch::Tensor int2_fp16_upcvt_gemm_run_torch(
    torch::Tensor A, torch::Tensor B, torch::Tensor scale_B,
    std::optional<torch::Tensor> C_out = std::nullopt) {
  RECORD_FUNCTION("int2_fp16_upcvt_gemm", {A, B});
  Timer t_("int2_fp16_upcvt_gemm");
  TORCH_CHECK(A.dtype() == torch::kHalf, "A must be fp16");
  TORCH_CHECK(B.dtype() == torch::kInt32, "B must be int32 (int2x16)");
  TORCH_CHECK(scale_B.dtype() == torch::kHalf, "scale_B must be fp16");
  TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
  TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
  TORCH_CHECK(scale_B.is_contiguous(), "scale_B must be contiguous");
  TORCH_CHECK(A.device().is_xpu(), "A must be on XPU");
  TORCH_CHECK(B.device().is_xpu() && scale_B.device().is_xpu(), "B/scale on XPU");
  TORCH_CHECK(A.dim() == 2 && B.dim() == 2 && scale_B.dim() == 2,
              "A,B,scale_B must be 2D");

  long m = A.size(0);
  long k = A.size(1);
  long n = B.size(1);
  TORCH_CHECK(k % 16 == 0, "k must be multiple of 16");
  TORCH_CHECK(k % 128 == 0, "k must be multiple of 128 (scale group size)");
  TORCH_CHECK(B.size(0) == k / 16, "B.size(0) must be k/16");
  TORCH_CHECK(scale_B.size(0) == k / 128, "scale_B.size(0) must be k/128");
  TORCH_CHECK(scale_B.size(1) == n, "scale_B.size(1) must be n");

  torch::Tensor C;
  if (C_out.has_value()) {
    TORCH_CHECK(C_out->dtype() == torch::kHalf, "C must be fp16");
    TORCH_CHECK(C_out->is_contiguous() && C_out->device().is_xpu(),
                "C must be contiguous XPU");
    TORCH_CHECK(C_out->size(0) == m && C_out->size(1) == n, "C shape mismatch");
    C = *C_out;
  } else {
    C = A.new_empty({m, n}, torch::kHalf);
  }

  auto q = c10::xpu::getCurrentXPUStream(A.device().index()).queue();
  sycl::half* a_ptr = reinterpret_cast<sycl::half*>(A.data_ptr<at::Half>());
  int32_t* b_ptr = B.data_ptr<int32_t>();
  sycl::half* c_ptr = reinterpret_cast<sycl::half*>(C.data_ptr<at::Half>());
  sycl::half* sb_ptr = reinterpret_cast<sycl::half*>(scale_B.data_ptr<at::Half>());

  {
    RECORD_FUNCTION("int2_fp16_upcvt_gemm_run", {});
    Timer t__("int2_fp16_upcvt_gemm_run");
    int2_fp16_upcvt_gemm_run(
        q, static_cast<size_t>(m), static_cast<size_t>(n),
        static_cast<size_t>(k), a_ptr, b_ptr, c_ptr, sb_ptr);
  }
  return C;
}

torch::Tensor int2_bf16_upcvt_gemm_run_torch(
    torch::Tensor A, torch::Tensor B, torch::Tensor scale_B,
    std::optional<torch::Tensor> C_out = std::nullopt) {
  RECORD_FUNCTION("int2_bf16_upcvt_gemm", {A, B});
  Timer t_("int2_bf16_upcvt_gemm");
  TORCH_CHECK(A.dtype() == torch::kBFloat16, "A must be bf16");
  TORCH_CHECK(B.dtype() == torch::kInt32, "B must be int32 (int2x16)");
  TORCH_CHECK(scale_B.dtype() == torch::kBFloat16, "scale_B must be bf16");
  TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
  TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
  TORCH_CHECK(scale_B.is_contiguous(), "scale_B must be contiguous");
  TORCH_CHECK(A.device().is_xpu(), "A must be on XPU");
  TORCH_CHECK(B.device().is_xpu() && scale_B.device().is_xpu(), "B/scale on XPU");
  TORCH_CHECK(A.dim() == 2 && B.dim() == 2 && scale_B.dim() == 2,
              "A,B,scale_B must be 2D");

  long m = A.size(0);
  long k = A.size(1);
  long n = B.size(1);
  TORCH_CHECK(k % 16 == 0, "k must be multiple of 16");
  TORCH_CHECK(k % 128 == 0, "k must be multiple of 128 (scale group size)");
  TORCH_CHECK(B.size(0) == k / 16, "B.size(0) must be k/16");
  TORCH_CHECK(scale_B.size(0) == k / 128, "scale_B.size(0) must be k/128");
  TORCH_CHECK(scale_B.size(1) == n, "scale_B.size(1) must be n");

  torch::Tensor C;
  if (C_out.has_value()) {
    TORCH_CHECK(C_out->dtype() == torch::kBFloat16, "C must be bf16");
    TORCH_CHECK(C_out->is_contiguous() && C_out->device().is_xpu(),
                "C must be contiguous XPU");
    TORCH_CHECK(C_out->size(0) == m && C_out->size(1) == n, "C shape mismatch");
    C = *C_out;
  } else {
    C = A.new_empty({m, n}, torch::kBFloat16);
  }

  using xbf16 = gpu::xetla::bf16;
  auto q = c10::xpu::getCurrentXPUStream(A.device().index()).queue();
  auto* a_ptr = reinterpret_cast<xbf16*>(A.data_ptr<at::BFloat16>());
  int32_t* b_ptr = B.data_ptr<int32_t>();
  auto* c_ptr = reinterpret_cast<xbf16*>(C.data_ptr<at::BFloat16>());
  auto* sb_ptr = reinterpret_cast<xbf16*>(scale_B.data_ptr<at::BFloat16>());

  {
    RECORD_FUNCTION("int2_bf16_upcvt_gemm_run", {});
    Timer t__("int2_bf16_upcvt_gemm_run");
    int2_bf16_upcvt_gemm_run(
        q, static_cast<size_t>(m), static_cast<size_t>(n),
        static_cast<size_t>(k), a_ptr, b_ptr, c_ptr, sb_ptr);
  }
  return C;
}

// NOTE: the TORCH_LIBRARY_FRAGMENT registration for this op lives in
// int2_kernel_wrapper.cpp. With the SYCL host compiler in oneAPI 2025.3,
// global ctors emitted from a `.sycl` translation unit are not always
// executed at .so load time, which silently leaves the op unregistered.
// Putting the FRAGMENT in a regular `.cpp` works around that.
